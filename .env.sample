# Application
APP_ENV=development
HTTP_ADDR=:8090
JWT_SECRET=change-me-in-production
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password

# PostgreSQL
DB_DRIVER=postgres
POSTGRES_USER=pg
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DSN="host=localhost port=5432 user=pg password=change-me dbname=fluxa sslmode=disable"
AUTO_MIGRATE=true

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_REPLICAS=1

# Optional GitLab integration
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_TIMEOUT_SECONDS=10
