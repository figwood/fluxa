APP_ENV=development
HTTP_ADDR=:8090
TRUSTED_PROXIES=
DB_DRIVER=sqlite
SQLITE_PATH=./data/fluxa.db
POSTGRES_DSN=host=127.0.0.1 user=fluxa password=fluxa dbname=fluxa port=5432 sslmode=disable TimeZone=Asia/Shanghai
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_TIMEOUT_SECONDS=10
AUTO_MIGRATE=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_ID=
WORKER_REPLICAS=1
JWT_SECRET=
ACCESS_TOKEN_TTL_HOURS=8
BOOTSTRAP_ADMIN_PASSWORD=
